/// A 5x7 arcade pixel font drawn with rectangles (from v1), plus outlined and gradient text
/// for the bubbly arcade titles. Text is drawn in uppercase.

function pixel_font_init()
{
    if (variable_global_exists("pixel_glyphs")) return;
    global.pixel_glyphs = {};

    var _add = function(_ch, _rows)
    {
        var _pixels = [];
        for (var _r = 0; _r < 7; _r++)
        {
            for (var _c = 0; _c < 5; _c++)
            {
                if (string_char_at(_rows[_r], _c + 1) == "#") array_push(_pixels, [_c, _r]);
            }
        }
        global.pixel_glyphs[$ _ch] = _pixels;
    };

    _add("A", [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"]);
    _add("B", ["####.", "#...#", "#...#", "####.", "#...#", "#...#", "####."]);
    _add("C", [".###.", "#...#", "#....", "#....", "#....", "#...#", ".###."]);
    _add("D", ["####.", "#...#", "#...#", "#...#", "#...#", "#...#", "####."]);
    _add("E", ["#####", "#....", "#....", "####.", "#....", "#....", "#####"]);
    _add("F", ["#####", "#....", "#....", "####.", "#....", "#....", "#...."]);
    _add("G", [".###.", "#...#", "#....", "#.###", "#...#", "#...#", ".####"]);
    _add("H", ["#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"]);
    _add("I", [".###.", "..#..", "..#..", "..#..", "..#..", "..#..", ".###."]);
    _add("J", ["..###", "...#.", "...#.", "...#.", "...#.", "#..#.", ".##.."]);
    _add("K", ["#...#", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "#...#"]);
    _add("L", ["#....", "#....", "#....", "#....", "#....", "#....", "#####"]);
    _add("M", ["#...#", "##.##", "#.#.#", "#.#.#", "#...#", "#...#", "#...#"]);
    _add("N", ["#...#", "#...#", "##..#", "#.#.#", "#..##", "#...#", "#...#"]);
    _add("O", [".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."]);
    _add("P", ["####.", "#...#", "#...#", "####.", "#....", "#....", "#...."]);
    _add("Q", [".###.", "#...#", "#...#", "#...#", "#.#.#", "#..#.", ".##.#"]);
    _add("R", ["####.", "#...#", "#...#", "####.", "#.#..", "#..#.", "#...#"]);
    _add("S", [".####", "#....", "#....", ".###.", "....#", "....#", "####."]);
    _add("T", ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "..#.."]);
    _add("U", ["#...#", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."]);
    _add("V", ["#...#", "#...#", "#...#", "#...#", "#...#", ".#.#.", "..#.."]);
    _add("W", ["#...#", "#...#", "#...#", "#.#.#", "#.#.#", "#.#.#", ".#.#."]);
    _add("X", ["#...#", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "#...#"]);
    _add("Y", ["#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#.."]);
    _add("Z", ["#####", "....#", "...#.", "..#..", ".#...", "#....", "#####"]);

    _add("0", [".###.", "#...#", "#..##", "#.#.#", "##..#", "#...#", ".###."]);
    _add("1", ["..#..", ".##..", "..#..", "..#..", "..#..", "..#..", ".###."]);
    _add("2", [".###.", "#...#", "....#", "...#.", "..#..", ".#...", "#####"]);
    _add("3", ["####.", "....#", "....#", ".###.", "....#", "....#", "####."]);
    _add("4", ["...#.", "..##.", ".#.#.", "#..#.", "#####", "...#.", "...#."]);
    _add("5", ["#####", "#....", "####.", "....#", "....#", "#...#", ".###."]);
    _add("6", ["..##.", ".#...", "#....", "####.", "#...#", "#...#", ".###."]);
    _add("7", ["#####", "....#", "...#.", "..#..", ".#...", ".#...", ".#..."]);
    _add("8", [".###.", "#...#", "#...#", ".###.", "#...#", "#...#", ".###."]);
    _add("9", [".###.", "#...#", "#...#", ".####", "....#", "...#.", ".##.."]);

    _add(":", [".....", "..#..", "..#..", ".....", "..#..", "..#..", "....."]);
    _add("!", ["..#..", "..#..", "..#..", "..#..", "..#..", ".....", "..#.."]);
    _add("?", [".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.."]);
    _add(".", [".....", ".....", ".....", ".....", ".....", ".....", "..#.."]);
    _add(",", [".....", ".....", ".....", ".....", ".....", "..#..", ".#..."]);
    _add("'", ["..#..", "..#..", ".....", ".....", ".....", ".....", "....."]);
    _add("-", [".....", ".....", ".....", ".###.", ".....", ".....", "....."]);
    _add("+", [".....", "..#..", "..#..", "#####", "..#..", "..#..", "....."]);
    _add("/", ["....#", "....#", "...#.", "..#..", ".#...", "#....", "#...."]);
    _add("_", [".....", ".....", ".....", ".....", ".....", ".....", "#####"]);
    _add("<", ["...#.", "..#..", ".#...", "#....", ".#...", "..#..", "...#."]);
    _add(">", [".#...", "..#..", "...#.", "....#", "...#.", "..#..", ".#..."]);
    _add("*", [".....", "#.#.#", ".###.", "#####", ".###.", "#.#.#", "....."]);
    _add("=", [".....", ".....", "#####", ".....", "#####", ".....", "....."]);
    _add(" ", [".....", ".....", ".....", ".....", ".....", ".....", "....."]);
}

function pixel_text_width(_text, _scale)
{
    var _n = string_length(_text);
    return (_n <= 0) ? 0 : _n * 6 * _scale - _scale;
}

/// Plain pixel text. _col_bottom, if given, shades each glyph row from _col to _col_bottom.
function pixel_text(_x, _y, _text, _scale, _col, _halign = fa_left, _alpha = 1, _col_bottom = undefined)
{
    _text = string_upper(_text);
    var _w = pixel_text_width(_text, _scale);
    if (_halign == fa_center) _x -= _w div 2;
    else if (_halign == fa_right) _x -= _w;
    _x = round(_x);
    _y = round(_y);

    draw_set_alpha(_alpha);
    var _n = string_length(_text);
    for (var _i = 0; _i < _n; _i++)
    {
        var _glyph = global.pixel_glyphs[$ string_char_at(_text, _i + 1)];
        if (is_undefined(_glyph)) continue;
        var _gx = _x + _i * 6 * _scale;
        for (var _p = 0; _p < array_length(_glyph); _p++)
        {
            var _row = _glyph[_p][1];
            draw_set_colour(is_undefined(_col_bottom) ? _col : merge_colour(_col, _col_bottom, _row / 6));
            var _px = _gx + _glyph[_p][0] * _scale;
            var _py = _y + _row * _scale;
            // Filled rectangles stop one pixel short of x2/y2, so x2 = x1 + scale fills exactly scale pixels.
            draw_rectangle(_px, _py, _px + _scale, _py + _scale, false);
        }
    }
    draw_set_alpha(1);
}

/// Arcade text with a dark outline all round (and an optional drop shadow), like the cabinet titles.
function pixel_text_outline(_x, _y, _text, _scale, _col, _outline, _halign = fa_left, _col_bottom = undefined, _shadow = true)
{
    var _o = max(1, _scale div 2);
    if (_shadow) pixel_text(_x + _o * 2, _y + _o * 2, _text, _scale, c_black, _halign, 0.6);
    for (var _dx = -_o; _dx <= _o; _dx += _o)
    {
        for (var _dy = -_o; _dy <= _o; _dy += _o)
        {
            if (_dx != 0 || _dy != 0) pixel_text(_x + _dx, _y + _dy, _text, _scale, _outline, _halign);
        }
    }
    pixel_text(_x, _y, _text, _scale, _col, _halign, 1, _col_bottom);
}
