/// Embersand: the controller. Owns the screens, the camera, the map and the sides.
defs_init();
missions_init();
fx_init();
global.sfx = sfx_init();
global.snd_last = {};
global.u_team = shader_get_uniform(sh_team, "u_team");
global.tmp_list = ds_list_create();

global.f_small = font_add("Bahnschrift", 10, false, false, 32, 127);
global.f_ui = font_add("Bahnschrift", 13, true, false, 32, 127);
global.f_big = font_add("Bahnschrift", 26, true, false, 32, 127);
global.f_logo = font_add("Bahnschrift", 72, true, false, 32, 127);

// Screen: the world is drawn at half size into the application surface and scaled up 2x beside the sidebar.
window_set_size(GUI_W, GUI_H);
display_set_gui_maximise(1, 1, 0, 0);
gui_w = GUI_W;
gui_h = GUI_H;
global.view_s = 1;
global.view_ox = 0;
global.view_oy = 0;
global.win_i = 0;
global.recentre = 0;
global.cam = camera_create_view(0, 0, VIEW_W, VIEW_H);
view_enabled = true;
view_visible[0] = true;
view_camera[0] = global.cam;
view_xport[0] = 0;
view_yport[0] = 0;
view_wport[0] = VIEW_W;
view_hport[0] = VIEW_H;
surface_resize(application_surface, VIEW_W, VIEW_H);
application_surface_draw_enable(false);
window_set_cursor(cr_none);
centred = false;

// Settings and progress
global.player_side = 0;
global.difficulty = 1;
global.sound_off = false;
global.edge_scroll = true;
global.speed_i = 1;
global.done = array_create(array_length(global.missions), false);
ini_open("embersand.ini");
for (var _m = 0; _m < array_length(global.missions); _m++) global.done[_m] = ini_read_real("progress", "m" + string(_m), 0) == 1;
global.player_side = ini_read_real("settings", "side", 0);
global.difficulty = ini_read_real("settings", "difficulty", 1);
ini_close();

// State
global.state = "title";
global.ui_t = 0;
global.brief_index = 0;
global.brief_chars = 0;
global.frame = 0;
global.paused = false;
global.teams = [];
global.decals = [];
global.sel = [];
global.sel_one = noone;
global.hover = noone;
global.placing = "";
global.place_cx = 0;
global.place_cy = 0;
global.cmd = "";
global.tab = 0;
global.tip = "";
global.drag = false;
global.drag_x = 0;
global.drag_y = 0;
global.pan = false;
global.pan_x = 0;
global.pan_y = 0;
global.click_t = -100;
global.click_type = "";
global.groups = array_create(10, []);
global.last_group = -1;
global.last_group_t = -100;
global.message = "";
global.message_t = 0;
global.alert_frame = -99999;
global.alert_x = -1;
global.alert_y = -1;
global.shake = 0;
global.cam_x = 0;
global.cam_y = 0;
global.mouse_wx = 0;
global.mouse_wy = 0;
global.gx = 0;
global.gy = 0;
global.ui_clicked = false;
global.order_fx = [];
global.result = "";
global.end_t = 0;
global.mw = 1;
global.mh = 1;
global.terr = -1;
global.shroud_surf = -1;
global.mm_base = -1;
global.mm_surf = -1;
global.minimap_dirty = true;
global.mission = undefined;
global.mission_index = 0;
global.tech = 1;
global.ai_speed = 1;

instance_create_depth(0, 0, 9000, obj_ground);

var _test = environment_get_variable("EMBERSAND_TEST");
global.autotest = _test != "";
global.test_mission = global.autotest ? clamp(real(_test) - 1, 0, 2) : 0;
global.test_t = 0;
global.test_shot = -1;
global.test_dir = environment_get_variable("EMBERSAND_TEST_DIR");
global.test_order = [];
global.test_end = 0;
global.test_pause_t = 0;
global.test_frames = global.autotest ? real("0" + environment_get_variable("EMBERSAND_TEST_FRAMES")) : 0;
if (global.test_frames <= 0) global.test_frames = 24000;
